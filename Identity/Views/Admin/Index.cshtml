@model IEnumerable<AppUser>

<div class="bg-primary m-1 p-1 text-wite">
    <h4>User Accounts</h4>
</div>

<table class="table table-sm table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
    </tr>
    
    @if (Model.Count() == 0)
    {
        <tr>
            <td colspan="3" class="text-center">No User Account</td>
        </tr>
    }
    else
    {
        foreach (var appUser in Model)
        {
            <tr>
                <td>@appUser.Id</td>
                <td>@appUser.UserName</td>
                <td>@appUser.Email</td>
            </tr>
        }
    }
</table>
<a class="btn btn-primary" asp-action="Create">Create</a>